# Easner Website Admin (admin.easner.com). Copy to .env.local.
#
# The website Supabase project (easner-website), never the banking one.
# Local: run `supabase start` in the repo root and use the values it prints
# (API URL http://127.0.0.1:54321 and the publishable / anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Website hooks (server only, never NEXT_PUBLIC_). See README, "Website hooks". Leave unset to skip them.
WEBSITE_URL=
BLOG_REVALIDATE_SECRET=
BLOG_PREVIEW_SECRET=
INDEXNOW_KEY=

# Development only: exposes /dev/editor, the editor without Supabase. Ignored unless NODE_ENV=development.
# ADMIN_DEV_HARNESS=1
