# Easner Website Admin (admin.easner.com). Set these in Vercel (Production) and in the git-ignored admin/.env.local.
# Server-only values must never be prefixed with NEXT_PUBLIC_. Nothing here is committed with a value.
# The build needs none of them: a missing value turns that feature off (and says so) instead of breaking a page.

# --- Required to sign in and use the admin (the easner-website Supabase project, never the banking one) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Website hooks (publish, unpublish, slug changes, preview). Skipped with a note when missing ---
# Base URL of the public site, e.g. https://www.easner.com
WEBSITE_URL=
# The same values as in the website's environment
BLOG_REVALIDATE_SECRET=
BLOG_PREVIEW_SECRET=
# Optional: pinged on publish. The website serves the key at /api/indexnow-key (set the same value there)
INDEXNOW_KEY=

# --- Cron jobs (vercel.json) ---
# Authorises /api/cron/*. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. At least 16 characters.
# Generate one: openssl rand -hex 24
CRON_SECRET=
# The Supabase secret key (sb_secret_...) of the easner-website project. The cron routes use it. It bypasses RLS:
# keep it out of the browser and out of logs.
SUPABASE_SECRET_KEY=

# --- Analytics (optional; without them Analytics shows "Connect PostHog") ---
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# POSTHOG_HOST=https://us.posthog.com
# GSC_SITE_URL=sc-domain:easner.com
# GSC_SERVICE_ACCOUNT_JSON=

# --- Development only (never in Vercel) ---
# With NODE_ENV=development this enables /dev/editor, /dev/analytics and /dev/redirects
# ADMIN_DEV_HARNESS=1
