# Server only. Never prefix these with NEXT_PUBLIC_. Set them in Vercel (Production), not in git.

# Authorises the scheduled publish job. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate one: openssl rand -hex 24
CRON_SECRET=

# The Supabase secret key (sb_secret_...) of the easner-website project. The cron route uses it to call publish_post
# for posts whose time has come. It bypasses RLS: keep it out of the browser and out of logs.
SUPABASE_SECRET_KEY=
