{
  "name": "easner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*",
    "website",
    "admin"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=website",
    "dev:website": "turbo run dev --filter=website",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "build:website": "turbo run build --filter=website",
    "build:admin": "turbo run build --filter=admin",
    "build:shared": "turbo run build --filter=@easner/shared",
    "lint": "turbo run lint",
    "start:website": "turbo run start --filter=website",
    "start:admin": "turbo run start --filter=admin",
    "test:db": "node supabase/tests/run-db-tests.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "turbo": "^2.8.12"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
