# Website (easner.com) environment variables

# App URL - used for early-access form POST target and Login links
NEXT_PUBLIC_APP_URL=https://app.easner.com

# Universal Links (iOS) – Apple Developer → Membership → Team ID (10 chars)
# See website/UNIVERSAL-LINKS.md
APPLE_TEAM_ID=

# Android App Links – Play Console app signing SHA-256 (comma-separated)
ANDROID_SHA256_CERT_FINGERPRINTS=

# PostHog - analytics and visitor tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Smart download link (www.easner.com/app) — see website/DOWNLOAD.md
NEXT_PUBLIC_APP_LINK_URL=https://www.easner.com/app

# Store / APK destinations (same names as easnerbanking)
EASNER_APP_STORE_URL=https://apps.apple.com/us/app/easner/id6762069433
# EASNER_PLAY_STORE_URL=                 # set when Play Store is live
# NEXT_PUBLIC_ANDROID_APK_URL=           # optional APK override
# EASNER_DOWNLOAD_PAGE_URL=https://www.easner.com/app

# Download-link email API (easnerbanking — CORS allows www.easner.com)
NEXT_PUBLIC_APP_DOWNLOAD_API_URL=https://api.easner.com/api/marketing/app-download-link

# Intercom live chat (same workspace as business.easner.com / app.easner.com)
NEXT_PUBLIC_INTERCOM_APP_ID=
NEXT_PUBLIC_INTERCOM_REGION=us
